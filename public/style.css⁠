:root {
  --primary: #2563eb;
  --bg: #f8fafc;
  --card-bg: #ffffff;
  --text: #1e293b;
  --border: #e2e8f0;
  --danger: #ef4444;
  --success: #10b981;
}

* { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
body { background: var(--bg); color: var(--text); padding-bottom: 70px; }

.top-bar { background: var(--primary); color: #fff; padding: 16px; text-align: center; display: flex; justify-content: center; align-items: center; gap: 8px; }
.sub-tag { background: rgba(255,255,255,0.2); font-size: 12px; padding: 2px 6px; border-radius: 4px; }

main { padding: 16px; max-width: 600px; margin: 0 auto; }
.view { display: none; }
.view.active { display: block; }

.welcome-card, .card { background: var(--card-bg); padding: 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px; }
.welcome-card h2 { margin-bottom: 8px; }

.primary-btn { background: var(--primary); color: #fff; border: none; padding: 12px 20px; border-radius: 8px; width: 100%; font-weight: bold; cursor: pointer; margin-top: 8px; }
.secondary-btn { background: #e2e8f0; color: var(--text); border: none; padding: 10px; border-radius: 8px; width: 48%; font-weight: bold; cursor: pointer; }
.danger-btn { background: var(--danger); color: #fff; border: none; padding: 12px; border-radius: 8px; width: 100%; font-weight: bold; cursor: pointer; margin-top: 8px; }

.quick-stats { display: flex; gap: 8px; margin-bottom: 16px; }
.stat-box { flex: 1; background: var(--card-bg); padding: 12px; text-align: center; border-radius: 8px; border: 1px solid var(--border); }
.stat-box span { font-size: 20px; font-weight: bold; display: block; color: var(--primary); }

.form-group { margin-bottom: 16px; }
.form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 14px; }
select, input { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); font-size: 16px; }

.upload-btn-group { display: flex; justify-content: space-between; }
.preview-box { margin: 16px 0; text-align: center; }
.preview-box img, .img-preview-small img { max-width: 100%; max-height: 250px; border-radius: 8px; }

.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: var(--card-bg); border-top: 1px solid var(--border); display: flex; justify-around: space-around; padding: 8px 0; }
.nav-item { background: none; border: none; font-size: 10px; color: #64748b; cursor: pointer; }
.nav-item.active { color: var(--primary); font-weight: bold; }

.hidden { display: none !important; }
.disabled { opacity: 0.5; cursor: not-allowed; }

.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); color: #fff; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 100; }
.spinner { width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

.detected-box { background: #f1f5f9; padding: 12px; border-radius: 6px; margin: 12px 0; white-space: pre-wrap; font-family: monospace; }
.btn-row { display: flex; gap: 8px; }
.badge-list { list-style: none; }
.badge-list li { background: #e0e7ff; color: #3730a3; padding: 6px 12px; border-radius: 20px; display: inline-block; margin: 4px 4px 4px 0; font-size: 12px; }
